<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#33000000" />
            <size android:width="46dp" android:height="46dp" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:endColor="#3B7BFF"
                android:startColor="#5BA3FF" />
            <stroke
                android:width="1.5dp"
                android:color="#E8F0FF" />
        </shape>
    </item>
</layer-list>
