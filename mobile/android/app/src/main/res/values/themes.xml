<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.JobScamGuard" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#4D8DFF</item>
        <item name="android:statusBarColor">#0A0E14</item>
        <item name="android:navigationBarColor">#0A0E14</item>
        <item name="android:windowBackground">#0A0E14</item>
    </style>
    <style name="Theme.CropOverlay" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFullscreen">true</item>
    </style>
    <style name="Theme.Transparent" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
</resources>
